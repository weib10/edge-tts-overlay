<Window x:Class="EdgeTtsOverlay.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edge TTS 設定" Width="620" Height="620" WindowStartupLocation="CenterOwner" Background="#F51B2331" Foreground="#F8FAFF">
 <ScrollViewer><Grid Margin="22"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="聲音" VerticalAlignment="Center"/><ComboBox x:Name="VoiceBox" Grid.Column="1" Margin="4" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="語音選擇"/>
  <TextBlock Grid.Row="1" Text="速度 (%)" VerticalAlignment="Center"/><TextBox x:Name="RateBox" Grid.Row="1" Grid.Column="1" Margin="4"/>
  <TextBlock Grid.Row="2" Text="音量 (%)" VerticalAlignment="Center"/><TextBox x:Name="VolumeBox" Grid.Row="2" Grid.Column="1" Margin="4"/>
  <TextBlock Grid.Row="3" Text="音高 (Hz)" VerticalAlignment="Center"/><TextBox x:Name="PitchBox" Grid.Row="3" Grid.Column="1" Margin="4"/>
  <CheckBox x:Name="ReadingModeBox" Grid.Row="4" Grid.ColumnSpan="2" Margin="4,12" Content="閱讀模式（略過 URL 與程式碼塊）"/>
  <CheckBox x:Name="StartupBox" Grid.Row="5" Grid.ColumnSpan="2" Margin="4" Content="登入 Windows 時自動啟動"/>
  <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="4,14,4,4" Text="快捷鍵（例如 Ctrl+Alt+R；儲存後立即套用）" FontWeight="SemiBold"/>
  <UniformGrid Grid.Row="7" Grid.ColumnSpan="2" Columns="2"><TextBlock Text="顯示／隱藏"/><TextBox x:Name="ToggleBox"/><TextBlock Text="取代朗讀"/><TextBox x:Name="ReplaceBox"/><TextBlock Text="追加佇列"/><TextBox x:Name="AppendBox"/><TextBlock Text="暫停／繼續"/><TextBox x:Name="PauseBox"/><TextBlock Text="停止"/><TextBox x:Name="StopBox"/></UniformGrid>
  <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Margin="4,14,4,4" Text="術語字典（一行：術語=讀法，完整詞最長優先）" FontWeight="SemiBold"/>
  <TextBox x:Name="DictionaryBox" Grid.Row="9" Grid.ColumnSpan="2" Height="120" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
  <TextBox x:Name="TestSentenceBox" Grid.Row="10" Grid.ColumnSpan="2" Margin="4,10,4,0" Text="這個 API 回傳 JSON，請用 Python 3.12 跑一次。" AutomationProperties.Name="試聽句"/>
  <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="試聽例句" MinWidth="90" MinHeight="40" Margin="4" Click="OnTest"/><Button Content="儲存" MinWidth="90" MinHeight="40" Margin="4" Click="OnSave"/></StackPanel>
 </Grid></ScrollViewer>
</Window>
