<Window x:Class="EdgeTtsOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edge TTS 設定" Width="620" Height="680" MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable Text"
        Background="{StaticResource DialogSurface}" Foreground="{StaticResource TextPrimary}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,18,0">
            <StackPanel>
                <Border CornerRadius="18" Padding="18" Margin="0,0,6,14" Background="{StaticResource DialogCard}"
                        BorderBrush="{StaticResource ControlRim}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="聲音" Style="{StaticResource SectionHeader}"/>
                        <ComboBox x:Name="VoiceBox" SelectedValuePath="Id" AutomationProperties.Name="語音選擇">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="速度 (-50 ~ 100 %)" Style="{StaticResource FieldLabel}" Margin="2,0,0,5"/>
                                <TextBox x:Name="RateBox" AutomationProperties.Name="語速百分比"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="音量 (-50 ~ 50 %)" Style="{StaticResource FieldLabel}" Margin="2,0,0,5"/>
                                <TextBox x:Name="VolumeBox" AutomationProperties.Name="音量百分比"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="音高 (-50 ~ 50 Hz)" Style="{StaticResource FieldLabel}" Margin="2,0,0,5"/>
                                <TextBox x:Name="PitchBox" AutomationProperties.Name="音高赫茲"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border CornerRadius="18" Padding="18" Margin="0,0,6,14" Background="{StaticResource DialogCard}"
                        BorderBrush="{StaticResource ControlRim}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="行為" Style="{StaticResource SectionHeader}"/>
                        <CheckBox x:Name="ReadingModeBox" Margin="2,2,0,0" Content="閱讀模式（略過 URL 與程式碼塊）"/>
                        <CheckBox x:Name="StartupBox" Margin="2,12,0,0" Content="登入 Windows 時自動啟動"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="18" Padding="18" Margin="0,0,6,14" Background="{StaticResource DialogCard}"
                        BorderBrush="{StaticResource ControlRim}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="快捷鍵" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="例如 Ctrl+Alt+R；儲存後立即套用。" Style="{StaticResource FieldLabel}" Margin="4,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="顯示／隱藏" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                            <TextBox x:Name="ToggleBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" AutomationProperties.Name="顯示或隱藏快捷鍵"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="取代朗讀" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                            <TextBox x:Name="ReplaceBox" Grid.Row="0" Grid.Column="4" Margin="0,0,0,10" AutomationProperties.Name="取代朗讀快捷鍵"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="追加佇列" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                            <TextBox x:Name="AppendBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" AutomationProperties.Name="追加佇列快捷鍵"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="暫停／繼續" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                            <TextBox x:Name="PauseBox" Grid.Row="1" Grid.Column="4" Margin="0,0,0,10" AutomationProperties.Name="暫停或繼續快捷鍵"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="停止" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                            <TextBox x:Name="StopBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="停止快捷鍵"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border CornerRadius="18" Padding="18" Margin="0,0,6,14" Background="{StaticResource DialogCard}"
                        BorderBrush="{StaticResource ControlRim}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="術語字典" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="一行一條，格式是「術語=讀法」；同時命中時最長的那條優先。" Style="{StaticResource FieldLabel}" Margin="4,0,0,10"/>
                        <TextBox x:Name="DictionaryBox" Height="130" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" AutomationProperties.Name="術語字典"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="24,16" Background="#14000814" BorderThickness="0,1,0,0" BorderBrush="#1FFFFFFF">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TestSentenceBox" VerticalAlignment="Center" Margin="0,0,14,0"
                         Text="這個 API 回傳 JSON，請用 Python 3.12 跑一次。" AutomationProperties.Name="試聽句"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="試聽例句" MinWidth="96" Click="OnTest"/>
                    <Button Content="儲存" MinWidth="96" Margin="10,0,0,0" Background="#528FB7FF" BorderBrush="#85A9CCFF" Click="OnSave"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
